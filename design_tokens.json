{
  "colors": {
    "white": "#FFFFFF",
    "black": "#000000",
    "black-50": "#F2F2F2",
    "black-100": "#E5E5E5",
    "black-500": "#808080",
    "black-600": "#666666",
    "black-700": "#4D4D4D",
    "black-800": "#333333",
    "black-900": "#1A1A1A",
    "system-blue": "#007AFF",
    "system-red": "#FF3B30",
    "system-orange": "#FF9500",
    "system-green": "#26A212",
    "input-bg": "#F2F2F2",
    "input-border": "#E5E5E5",
    "button-dark": "#333333",
    "placeholder": "#808080"
  },
  "typography": {
    "title": {
      "fontFamily": "Poppins",
      "fontWeight": 600,
      "fontSize": "20px",
      "lineHeight": "28px"
    },
    "button-label": {
      "fontFamily": "Roboto",
      "fontWeight": 700,
      "fontSize": "15px",
      "lineHeight": "20px",
      "letterSpacing": "0.3px"
    },
    "input-placeholder": {
      "fontFamily": "Roboto",
      "fontWeight": 400,
      "fontSize": "15px",
      "lineHeight": "20px"
    },
    "checkbox-label": {
      "fontFamily": "SF Pro Display",
      "fontWeight": 400,
      "fontSize": "12px",
      "lineHeight": "20px",
      "letterSpacing": "0.3px"
    },
    "small-text": {
      "fontFamily": "Roboto",
      "fontWeight": 400,
      "fontSize": "12px",
      "lineHeight": "16px",
      "letterSpacing": "-0.4px"
    }
  },
  "spacing": {
    "container-padding-desktop": "48px",
    "form-gap": "32px",
    "input-gap": "20px",
    "input-padding-x": "16px",
    "input-padding-y": "8px",
    "button-padding-x": "24px",
    "button-padding-y": "10px"
  },
  "borderRadius": {
    "input": "6px",
    "button": "6px",
    "container": "24px"
  },
  "components": {
    "input": {
      "height": "48px",
      "background": "#F2F2F2",
      "border": "0.5px solid #E5E5E5",
      "borderRadius": "6px",
      "padding": "8px 16px"
    },
    "primaryButton": {
      "height": "40px",
      "background": "#007AFF",
      "borderRadius": "6px",
      "padding": "10px 24px"
    },
    "googleButton": {
      "height": "40px",
      "background": "#333333",
      "borderRadius": "6px",
      "padding": "10px 16px"
    },
    "toggle": {
      "width": "40px",
      "height": "20px"
    }
  }
}
